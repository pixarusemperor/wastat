# Wasender (never commit real values — see PRD §50)
# Personal Access Token (account-wide; used for session management)
WASENDER_PAT=
# Per-session API keys are stored in the database, not here.
WASENDER_BASE_URL=https://www.wasenderapi.com/api

# Supabase (PostgreSQL Database & Realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Use the SESSION POOLER string (Dashboard -> Connect -> Session pooler):
# postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
# The direct db.<ref>.supabase.co host is IPv6-only and unreachable from IPv4-only hosts (e.g. Coolify).
DATABASE_URL=

# Cloudflare R2 (Primary Media Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Local media fallback directory
MEDIA_DIR=/app/data/media

# Server
PORT=3000
DB_PATH=/app/data/wastat.db

# Public origin of this deployment (used to build Wasender webhook URLs)
PUBLIC_BASE_URL=https://wassflow.orizongroup.online

# Coolify (deploy management — leave empty unless performing Coolify API ops)
COOLIFY_BASE_URL=https://your-coolify-panel.yourdomain.com
COOLIFY_API_TOKEN=
COOLIFY_APP_UUID=
COOLIFY_WEBHOOK=

