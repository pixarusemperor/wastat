# Wasender (never commit real values — see PRD §50)
# Personal Access Token (account-wide; used for session management)
WASENDER_PAT=
# Per-session API keys are stored in the database, not here.
WASENDER_BASE_URL=https://www.wasenderapi.com/api

# Cloudflare R2 (Optional — falls back to local disk if omitted)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Local media fallback directory
MEDIA_DIR=/app/data/media

# Server
PORT=3000
DB_PATH=/app/data/wastat.db

# Public origin of this deployment (used to build Wasender webhook URLs)
PUBLIC_BASE_URL=https://wassflow.orizongroup.online

